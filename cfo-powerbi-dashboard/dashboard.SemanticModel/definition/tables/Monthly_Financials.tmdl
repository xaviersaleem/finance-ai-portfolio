		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("C:\Users\Mehedi\Documents\TitanFlow\TitanFlow_CFO_Dashboard_Data.xlsx"), null, true),
				  #"Navigation 1" = Source{[Item = "Monthly_Financials", Kind = "Sheet"]}[Data],
